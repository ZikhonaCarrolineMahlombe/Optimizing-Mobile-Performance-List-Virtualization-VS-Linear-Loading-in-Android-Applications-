<?xml version="1.0" encoding="utf-8"?>
<!-- Results history screen: engine comparison summary plus every saved run. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/results_history_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical"
    tools:context=".ResultHistoryActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/results_history_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/espresso"
        app:navigationContentDescription="@string/results_back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/results_title"
        app:titleTextColor="@color/mist"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/results_history_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Engine comparison -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/results_comparison_header"
                    android:textColor="#172B4D"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/results_card_scrollview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/sage"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/results_scrollview_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/test_engine_scrollview"
                            android:textColor="#172B4D"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/results_scrollview_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="#253858"
                            android:textSize="14sp"
                            tools:text="4 runs • CPU 512 ms • Memory 48 MB • Frame 9.10 ms"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/results_card_recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/sage"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/results_recyclerview_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/test_engine_recyclerview"
                            android:textColor="#172B4D"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/results_recyclerview_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="#253858"
                            android:textSize="14sp"
                            tools:text="4 runs • CPU 210 ms • Memory 31 MB • Frame 6.42 ms"/>
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Saved runs -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/results_history_header"
                    android:textColor="#172B4D"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/results_history_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="@layout/item_result_history"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/results_export_all_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/results_export_all"
                    android:textColor="@color/espresso"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/slate"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/results_clear_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/results_clear_all"
                    android:textColor="@color/taupe"/>

            </LinearLayout>

        </ScrollView>

        <!-- Shown instead of content when no run has been saved yet -->
        <LinearLayout
            android:id="@+id/results_history_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/results_empty_title"
                android:textColor="#172B4D"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/results_empty_message"
                android:textColor="#526581"
                android:textSize="16sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/results_empty_run_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="32dp"
                android:text="@string/results_empty_action"
                android:textColor="@color/mist"
                app:backgroundTint="@color/espresso"
                app:cornerRadius="12dp"/>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>