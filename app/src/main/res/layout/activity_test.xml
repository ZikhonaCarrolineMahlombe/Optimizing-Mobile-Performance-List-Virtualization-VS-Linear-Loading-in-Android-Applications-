<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/test_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:orientation="vertical"
    tools:context=".TestActivity">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/test_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/test_abort_run"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/test_title" />

    <!-- Engine -->
    <LinearLayout
        android:id="@+id/test_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/test_screen_padding"
        android:paddingTop="@dimen/test_header_padding_vertical"
        android:paddingEnd="@dimen/test_screen_padding"
        android:paddingBottom="@dimen/test_header_padding_vertical">

        <TextView
            android:id="@+id/test_engine_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="ScrollView + LinearLayout" />

        <TextView
            android:id="@+id/test_run_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            tools:text="10 000 rows · iteration 1 of 5" />
    </LinearLayout>

    <!-- Metrics -->
    <LinearLayout
        android:id="@+id/test_metrics_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="@dimen/test_metric_strip_padding">

        <LinearLayout style="@style/Widget.RenderBench.MetricCell">
            <TextView
                style="@style/Widget.RenderBench.MetricLabel"
                android:text="@string/test_metric_rows" />
            <TextView
                android:id="@+id/test_metric_rows_value"
                style="@style/Widget.RenderBench.MetricValue"
                android:text="@string/test_metric_empty"
                tools:text="10 000" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.RenderBench.MetricCell">
            <TextView
                style="@style/Widget.RenderBench.MetricLabel"
                android:text="@string/test_metric_elapsed" />
            <TextView
                android:id="@+id/test_metric_elapsed_value"
                style="@style/Widget.RenderBench.MetricValue"
                android:text="@string/test_metric_empty"
                tools:text="12.4 s" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.RenderBench.MetricCell">
            <TextView
                style="@style/Widget.RenderBench.MetricLabel"
                android:text="@string/test_metric_status" />
            <TextView
                android:id="@+id/test_metric_status_value"
                style="@style/Widget.RenderBench.MetricValue"
                android:text="@string/test_metric_empty"
                tools:text="Scrolling" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scroll progress -->
    <ProgressBar
        android:id="@+id/test_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        tools:progress="35" />

    <!-- Lists area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Chosen Engine fragment -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/test_list_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Loading overlay -->
        <LinearLayout
            android:id="@+id/test_loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/windowBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/test_loading_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/test_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/test_overlay_spacing"
                android:textSize="16sp"
                tools:text="Building 10 000 rows…" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
