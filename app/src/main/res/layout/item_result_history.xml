<?xml version="1.0" encoding="utf-8"?>
<!-- One saved benchmark run in the Results history list -->
<com.google.android.material.card.MaterialCardView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/sage"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_result_engine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#172B4D"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="RecyclerView"/>

            <TextView
                android:id="@+id/item_result_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/taupe"
                android:textSize="13sp"
                tools:text="Completed"/>
        </LinearLayout>

        <TextView
            android:id="@+id/item_result_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#253858"
            android:textSize="14sp"
            tools:text="10 000 rows • iteration 2 of 5"/>

        <TextView
            android:id="@+id/item_result_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#253858"
            android:textSize="14sp"
            tools:text="CPU 210 ms • Memory 31 MB • Frame 6.42 ms"/>

        <TextView
            android:id="@+id/item_result_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#526581"
            android:textSize="12sp"
            tools:text="19 October 2026, 14:05"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>