<?xml version="1.0" encoding="utf-8"?>
<!-- List row, shared by both engines -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_row_height"
    android:background="@drawable/bg_item_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/test_screen_padding"
    android:paddingEnd="@dimen/test_screen_padding">

    <ImageView
        android:id="@+id/item_row_icon"
        android:layout_width="@dimen/item_row_icon_size"
        android:layout_height="@dimen/item_row_icon_size"
        android:contentDescription="@null"
        android:src="@drawable/ic_item_row" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_row_text_spacing"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="16sp"
            tools:text="Item 1" />

        <TextView
            android:id="@+id/item_row_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="14sp"
            tools:text="Description for item 1" />
    </LinearLayout>

</LinearLayout>
