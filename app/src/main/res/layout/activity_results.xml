<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/mist">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test Results"
            android:textColor="@color/espresso"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/results_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Not available"
            android:textColor="@color/taupe"
            android:textSize="16sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test configuration"
            android:textColor="@color/espresso"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/results_engine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rendering engine: —"
            android:textColor="@color/espresso"
            android:textSize="16sp"
            android:padding="6dp" />

        <TextView
            android:id="@+id/results_dataset_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dataset size: —"
            android:textColor="@color/espresso"
            android:textSize="16sp"
            android:padding="6dp" />

        <TextView
            android:id="@+id/results_iteration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iteration: —"
            android:textColor="@color/espresso"
            android:textSize="16sp"
            android:padding="6dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Performance metrics"
            android:textColor="@color/espresso"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/results_cpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CPU thread time: —"
            android:textColor="@color/espresso"
            android:textSize="16sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/results_memory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Java heap memory: —"
            android:textColor="@color/espresso"
            android:textSize="16sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/results_frame_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Latest frame time: —"
            android:textColor="@color/espresso"
            android:textSize="16sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/results_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Battery change: —"
            android:textColor="@color/espresso"
            android:textSize="16sp"
            android:padding="10dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/results_export_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export results to CSV" />

        <Button
            android:id="@+id/results_done_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Done"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
