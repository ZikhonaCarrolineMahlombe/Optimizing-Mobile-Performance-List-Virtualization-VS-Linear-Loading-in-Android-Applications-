<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ListPerformance" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/espresso</item>
        <item name="colorOnPrimary">@color/mist</item>
        <item name="colorSecondary">@color/slate</item>
        <item name="colorOnSurface">@color/espresso</item>
        <item name="android:windowBackground">@color/mist</item>
        <item name="android:textColorPrimary">@color/espresso</item>
        <item name="android:textColorSecondary">@color/taupe</item>
    </style>
    <!-- Set here, not on Base, so dark mode (values-night) gets it too -->
    <style name="Theme.ListPerformance" parent="Base.Theme.ListPerformance">
        <item name="toolbarStyle">@style/Widget.RenderBench.Toolbar</item>
    </style>

    <style name="Widget.RenderBench.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/espresso</item>
        <item name="titleTextColor">@color/mist</item>
        <item name="navigationIconTint">@color/mist</item>
    </style>

    <style name="Theme.RenderBench.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mist</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_gauge</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.ListPerformance</item>
    </style>
</resources>